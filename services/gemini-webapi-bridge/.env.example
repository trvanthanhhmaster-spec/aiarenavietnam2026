# Authentication is for gemini.google.com web sessions, not a Gemini Developer API key.
GEMINI_WEB_SECURE_1PSID=
GEMINI_WEB_SECURE_1PSIDTS=
# When enabled, refresh the two cookies from the local Chrome profile at
# startup and whenever the bridge reconnects after an auth failure.
GEMINI_WEB_AUTO_COOKIE_SYNC=false
GEMINI_WEB_CHROME_PROFILE=Default
GEMINI_WEB_AUTO_REFRESH=false
# Optional absolute path when Chrome uses a non-standard profile location.
GEMINI_WEB_CHROME_COOKIE_FILE=

# Keep the bridge private on the local machine by default.
GEMINI_WEB_BRIDGE_HOST=127.0.0.1
GEMINI_WEB_BRIDGE_PORT=8788
GEMINI_WEB_BRIDGE_SECRET=replace-with-a-long-local-secret
GEMINI_WEB_TIMEOUT_SECONDS=120

# Optional proxy if the Google web session requires one.
GEMINI_WEB_PROXY=
