SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_CACHE_TTL=300
SUPABASE_CACHE_FILE=/tmp/vremix-site-content.json
# Supabase Auth handles Studio accounts and Admin role checks.
# Admin > Đăng nhập Google updates the Google provider through Management API.
# Optional dedicated project-scoped token, server-side ONLY. Never use the CLI
# personal token or service_role as a substitute. See docs/google-auth-admin.md.
SUPABASE_MANAGEMENT_TOKEN=
# Allow this website redirect in Supabase Authentication > URL Configuration:
# http://localhost/aiarenavietnam2026/auth-callback.php
# Base64 của đúng 32 byte ngẫu nhiên; dùng cùng giá trị cho PHP và Edge Function.
AI_CONFIG_ENCRYPTION_KEY=
SITE_SLUG=home

# Optional provider based on HanaokaYuzu/Gemini-API. The Edge Function needs
# an authenticated HTTPS bridge URL; localhost only works for local callers.
GEMINI_WEB_BRIDGE_URL=
GEMINI_WEB_BRIDGE_SECRET=
GEMINI_WEB_LOCAL_ENABLED=false
